{
  "name": "v6m-mock",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "V6M Desk, the V6M Resort staff tool, and its single-use guest booking page. TypeScript, no framework, driven by local mock data.",
  "scripts": {
    "build": "tsc && node scripts/build-site.mjs",
    "watch": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "serve": "serve -l 4789 .",
    "start": "tsc && serve -l 4789 ."
  },
  "devDependencies": {
    "serve": "^14.2.6",
    "typescript": "^7.0.2"
  }
}
